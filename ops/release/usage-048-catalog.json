      "definition": "PRIMARY KEY (day)"
    },
    {
      "name": "usage_dirty_days_pkey",
      "type": "p",
      "relation": "usage_dirty_days",
      "definition": "PRIMARY KEY (day)"
    },
    {
      "name": "usage_rollup_jobs_check",
      "type": "c",
      "relation": "usage_rollup_jobs",
      "definition": "CHECK (((to_day >= from_day) AND ((to_day - from_day) < 31)))"
    },
    {
      "name": "usage_rollup_jobs_idempotency_key_key",
      "type": "u",
      "relation": "usage_rollup_jobs",
      "definition": "UNIQUE (idempotency_key)"
    },
    {
      "name": "usage_rollup_jobs_pkey",

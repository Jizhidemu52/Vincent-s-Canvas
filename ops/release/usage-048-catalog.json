      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "usage_rollup_jobs_status_check",
      "type": "c",
      "relation": "usage_rollup_jobs",
      "definition": "CHECK ((status = ANY (ARRAY['queued'::text, 'running'::text, 'completed'::text, 'failed'::text])))"

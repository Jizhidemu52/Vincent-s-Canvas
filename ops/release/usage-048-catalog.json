  "constraints": [
    {
      "name": "usage_daily_facts_kind_check",
      "type": "c",
      "relation": "usage_daily_facts",
      "definition": "CHECK ((kind = ANY (ARRAY['task'::text, 'event'::text, 'chat'::text])))"
    },
    {
      "name": "usage_daily_facts_payload_check",
      "type": "c",
      "relation": "usage_daily_facts",
      "definition": "CHECK ((jsonb_typeof(payload) = 'object'::text))"
    },
    {
      "name": "usage_daily_facts_pkey",
      "type": "p",
      "relation": "usage_daily_facts",
      "definition": "PRIMARY KEY (day, kind, fact_id)"
    },
    {
      "name": "usage_daily_snapshots_fact_bytes_check",
      "type": "c",
      "relation": "usage_daily_snapshots",
      "definition": "CHECK ((fact_bytes >= 0))"
    },
    {
      "name": "usage_daily_snapshots_fact_count_check",
      "type": "c",
      "relation": "usage_daily_snapshots",
      "definition": "CHECK ((fact_count >= 0))"
    },
    {
      "name": "usage_daily_snapshots_pkey",

POSTGRES_PASSWORD=replace-with-a-long-random-password
NODE_ENV=production
PORT=3100
SESSION_COOKIE_NAME=wireless_canvas_session
SESSION_TTL_SECONDS=28800
TRUST_PROXY=true
# Production requires authentication. Enable OA explicitly for employee SSO.
# Use an HTTPS gateway in front of this loopback-only HTTP listener.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=3000
AUTH_ENABLED=true
OA_LOGIN_ENABLED=false
OA_USERINFO_URL=https://oa.in-choice.com.cn:82/api/api/organization/user/info_login
CREDITS_ENABLED=false
ROLE_PORTALS_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=超级管理员
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-12-character-password
PROVIDER_ENCRYPTION_KEY=replace-with-a-second-openssl-rand-base64-32
WORKER_CONCURRENCY=10
# Includes waiting, processing and paused tasks, per employee.
USER_MAX_INFLIGHT_TASKS=100
WORKER_SHUTDOWN_GRACE_SECONDS=1200
TASK_MOCK_MODE=false
S3_ENDPOINT=http://minio:9000
# Optional public HTTPS endpoint for short-lived video/audio reference links.
# Keep S3_ENDPOINT private; do not expose the MinIO console or port 9000.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=wireless-canvas
S3_ACCESS_KEY_ID=wireless-canvas
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-object-storage-password
S3_FORCE_PATH_STYLE=true
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_URL=

# Required independent backup storage. Never point this at the business MinIO host.
# Provision bucket ACL, encryption and version lifecycle separately; keep the age private key offline.
BACKUP_S3_ENDPOINT=https://replace-with-independent-backup-host
BACKUP_S3_BUCKET=replace-with-backup-bucket
BACKUP_S3_ACCESS_KEY_ID=replace-with-backup-access-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-backup-secret-key
BACKUP_AGE_RECIPIENT=replace-with-age1-public-recipient
BACKUP_PREFIX=canvas
BACKUP_INTERVAL_SECONDS=900
BACKUP_FAILURE_WEBHOOK_URL=

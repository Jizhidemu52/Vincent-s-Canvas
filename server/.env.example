NODE_ENV=development
PORT=3100
DATABASE_URL=postgres://wireless_canvas:change-me@localhost:5432/wireless_canvas
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=wireless_canvas_session
SESSION_TTL_SECONDS=28800
TRUST_PROXY=false
# Independently configure login, internal credits and role portal visibility.
# Anonymous mode always disables internal credit billing; provider usage still costs money.
AUTH_ENABLED=true
CREDITS_ENABLED=true
ROLE_PORTALS_ENABLED=true
# Local demo only: empty uses server/.data/local-demo.sqlite (assets and tasks).
# Use a durable local path; this is not the formal PostgreSQL database.
DEMO_STATE_PATH=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=超级管理员
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-run
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_URL=
# Generate a 32-byte base64 key for external Provider credentials with: openssl rand -base64 32
PROVIDER_ENCRYPTION_KEY=
WORKER_CONCURRENCY=10
TASK_MOCK_MODE=false
# APIMart provider credentials. Keep the real value only in server/.env or your secret manager.
# Supports configured image/video models and Gemini/Claude native chat.
# For Gemini native chat, configure the Provider in the admin console with protocol=gemini
# and Base URL=https://api.apimart.ai. Do not add the key to web/.env or source files.
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_API_KEY=
# Backward-compatible aliases for older local GPT-Image-2 setup.
GPT_IMAGE_2_BASE_URL=
GPT_IMAGE_2_API_KEY=
S3_ENDPOINT=http://localhost:9000
# Public HTTPS object endpoint for provider video/audio references; the internal endpoint can stay private.
S3_PUBLIC_ENDPOINT=
# Optional absolute path to ffprobe; otherwise the server uses ffprobe from PATH.
FFPROBE_PATH=
S3_REGION=us-east-1
S3_BUCKET=wireless-canvas
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

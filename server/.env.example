NODE_ENV=development
PORT=3100
DATABASE_URL=postgres://wireless_canvas:change-me@localhost:5432/wireless_canvas
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=wireless_canvas_session
SESSION_TTL_SECONDS=28800
TRUST_PROXY=false
# Open the canvas directly; OA employee identification stays disabled.
# Existing employee records are retained, not merged into the open workspace.
# Internal credits are disabled; provider usage still costs money.
AUTH_ENABLED=false
OA_LOGIN_ENABLED=false
OA_USERINFO_URL=https://oa.in-choice.com.cn:82/api/api/organization/user/info_login
CREDITS_ENABLED=false
ROLE_PORTALS_ENABLED=false
# Local demo only: empty uses server/.data/local-demo.sqlite (assets and tasks).
# Use a durable local path; this is not the formal PostgreSQL database.
DEMO_STATE_PATH=
DEMO_CANVAS_TRYOUT_ENABLED=false
DEMO_SEEDREAM55_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=超级管理员
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-run
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_URL=
# Generate a 32-byte base64 key for external Provider credentials with: openssl rand -base64 32
PROVIDER_ENCRYPTION_KEY=
# Formal API + Worker only; optional HTTP origin, e.g. http://ai.in-choice.com.cn.
# Unsigned task reference links last at most 30 minutes. Blank keeps provider uploads.
PROVIDER_IMAGE_PUBLIC_ORIGIN=
WORKER_CONCURRENCY=10
TASK_MOCK_MODE=false
TRYOUT_DISPLAY_BEFORE_SAVE=true
# APIMart provider credentials. Keep the real value only in server/.env or your secret manager.
# Supports configured image/video models and Gemini/Claude native chat.
# For Gemini native chat, configure the Provider in the admin console with protocol=gemini
# and Base URL=https://api.apimart.ai. Do not add the key to web/.env or source files.
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_API_KEY=
# Backward-compatible aliases for older local GPT-Image-2 setup.
GPT_IMAGE_2_BASE_URL=
GPT_IMAGE_2_API_KEY=
S3_ENDPOINT=http://localhost:9000
# Public HTTPS object endpoint for provider video/audio references; the internal endpoint can stay private.
S3_PUBLIC_ENDPOINT=
# Optional absolute path to ffprobe; otherwise the server uses ffprobe from PATH.
FFPROBE_PATH=
S3_REGION=us-east-1
S3_BUCKET=wireless-canvas
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
PROMPT_OPTIMIZATION_TIMEOUT_MS=45000
PROMPT_OPTIMIZATION_FALLBACK=off
APIMART_IMAGE_DEFAULTS_ENABLED=false
TRYOUT_REFERENCE_MAX_EDGE=1536
PRODUCT_CARD_ENABLED=true
# PRODUCT_CARD_MODEL_CONFIG_ID=<vision-capable chat model configuration UUID>
APIMART_UPLOAD_CACHE_ENABLED=true
APIMART_CREATIVE_REFERENCE_TRANSPORT=signed-origin
APIMART_UPLOAD_RETENTION_DAYS=3
APIMART_DEFAULT_QUALITY=medium
APIMART_DEFAULT_COMPLEXITY=low
PROMPT_FALLBACK_TOOL_KEYS=
RESULT_REPAIR_ENABLED=true
PAUSED_TASK_LIMIT_PER_USER=20
RESULT_REPAIR_MAX_ATTEMPTS=3
RESULT_REPAIR_INTERVAL_SECONDS=60
